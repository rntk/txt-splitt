FROM python:3.12-slim

WORKDIR /app

# Create non-root user
RUN useradd --create-home --shell /bin/bash --uid 1000 appuser && \
    chown -R appuser:appuser /app

# Runtime dependency for OpenAI SDK-based clients (optional for LLamaCPP mode).
RUN pip install --no-cache-dir "openai>=2.0.0"

# The repository is expected to be mounted into /app at runtime.
ENV PYTHONPATH=/app/src

USER appuser

ENTRYPOINT ["python", "split_text.py"]

# sudo docker build -t otxt .
# sudo docker run --rm -v $(pwd):/app otxt